# Payments (Stripe Connect Direct Charges) — names only, never commit real values.
# Copy to .env.local for local testing (git-ignored) or set in Vercel > Project > Environment Variables.

# Server only
STRIPE_SECRET_KEY=sk_test_...                # test key; live keys are blocked unless PAYMENTS_ALLOW_LIVE=true
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...      # signing secret of the "connected accounts" webhook endpoint
PLATFORM_FEE_BPS=100                         # 1% JimmiPlay fee, half-up to the nearest penny
APP_ORIGIN=http://localhost:3000             # where Stripe returns players and hosts
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...            # server-only; calls the payments_* database functions
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  # used by the server to verify user tokens
CRON_SECRET=<random string>                  # Vercel Cron sends it as "Authorization: Bearer ..."
# PAYMENTS_ALLOW_LIVE=true                   # only after production approval

# Browser (public)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
